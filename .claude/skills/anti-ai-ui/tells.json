{
  "$schema": "anti-ai-ui-tells/v1",
  "color_hex_ban": [
    "#6366f1", "#4f46e5", "#8b5cf6", "#a855f7",
    "#ec4899", "#3b82f6", "#7c3aed", "#d946ef"
  ],
  "shadcn_hsl_default_fingerprints": [
    "222.2 84% 4.9%",
    "217.2 32.6% 17.5%",
    "210 40% 98%",
    "222.2 47.4% 11.2%",
    "215 20.2% 65.1%"
  ],
  "tailwind_class_patterns": [
    "from-indigo-[0-9]+",
    "to-purple-[0-9]+",
    "via-purple-[0-9]+",
    "from-violet-[0-9]+",
    "to-fuchsia-[0-9]+",
    "to-pink-[0-9]+",
    "bg-indigo-[56][0-9]{2}",
    "text-indigo-600",
    "ring-2 ring-indigo-500",
    "bg-gradient-to-br.*blur-3xl",
    "text-balance.*tracking-tight.*bg-clip-text"
  ],
  "copy_banlist": [
    "\\bunlock\\b",
    "\\bseamlessly\\b",
    "\\bempower\\b",
    "\\bsupercharge\\b",
    "\\bstreamline\\b",
    "\\belevate\\b",
    "\\bharness\\b",
    "\\bleverage\\b",
    "\\brevolutionize\\b",
    "\\bpowerful\\b",
    "beautifully crafted",
    "lightning[- ]fast",
    "next[- ]gen(eration)?",
    "built for the future",
    "trusted by teams",
    "loved by developers",
    "it's not just .* it's",
    "the future of \\w+",
    "your all[- ]in[- ]one platform",
    "scale without limits",
    "world[- ]class",
    "state[- ]of[- ]the[- ]art",
    "cutting[- ]edge"
  ],
  "structural_tells": [
    "em_dash_density_per_100_words_gt_1",
    "tricolon_in_marketing_copy",
    "emoji_prefix_badge_sparkle_rocket_lightning",
    "centered_hero_pill_badge_plus_dual_cta",
    "three_feature_cards_lucide_size_24_stroke_1_5",
    "bento_grid_as_section_two",
    "max_w_7xl_mx_auto_on_every_section",
    "trusted_by_logo_row",
    "pricing_three_tiers_ring_indigo_middle",
    "faq_accordion_before_footer",
    "footer_four_column_link_grid_plus_email_signup",
    "animate_pulse_on_more_than_one_non_loading_element",
    "transition_all_duration_300",
    "framer_motion_duration_0_5_no_ease_override",
    "single_font_family_inter_no_stylistic_sets",
    "font_weight_600_on_majority_of_text"
  ],
  "font_pairing_red_flags": [
    "Inter_alone_no_feature_settings",
    "Inter_plus_Instrument_Serif_italic_accent",
    "Inter_plus_Space_Grotesk",
    "Roboto_anywhere",
    "Arial_anywhere"
  ],
  "imports_to_flag": [
    "from \"@/lib/utils\" import { cn }.*shadcn_default_unmodified",
    "import.*from \"lucide-react\".*size=\\{?24\\}? strokeWidth=\\{?1\\.5\\}?"
  ],
  "composite_vibe_check": {
    "description": "A file fails the vibe check if it hits 3 or more of these in one component",
    "items": [
      "inter_as_sole_font",
      "any_indigo_violet_purple_gradient",
      "three_card_feature_row_lucide_24_1_5",
      "hero_pill_badge_plus_text_balance_plus_gradient_text_headline",
      "shadcn_card_or_button_defaults_unmodified",
      "copy_contains_two_or_more_banned_verbs",
      "transition_all_duration_300_or_framer_duration_0_5_default",
      "bento_grid_as_section_two",
      "max_w_7xl_mx_auto_on_every_section",
      "pure_white_or_black_no_warm_off_whites"
    ],
    "threshold": 3
  },
  "positive_signals": {
    "fonts": ["Geist", "Geist Mono", "Söhne", "ABC Diatype", "GT America", "Berkeley Mono", "JetBrains Mono", "Untitled Sans", "PP Neue Montreal", "PP Editorial New"],
    "colors": ["oklch(...)", "Radix Colors 12-step scale", "warm off-white #fafaf7 / #f5f4f0 / #f8f6f1"],
    "css_features": ["@property", "color-mix(in oklch, ...)", ":has()", "@starting-style", "view-transition-name", "animation-timeline: view()", "container-type: inline-size", "text-wrap: pretty", "text-wrap: balance", "hanging-punctuation: first", "initial-letter", "font-variant-numeric: tabular-nums", "font-feature-settings"],
    "easing_curves": {
      "ui_default": "cubic-bezier(0.23, 1, 0.32, 1)",
      "linear_snap": "cubic-bezier(0.16, 1, 0.3, 1)",
      "vaul_drawer": "cubic-bezier(0.32, 0.72, 0, 1)",
      "image_reveal": "cubic-bezier(0.77, 0, 0.175, 1)",
      "subtle_overshoot": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "duration_ceiling_ms": {
      "ui_feedback": 200,
      "modal_drawer": 500,
      "absolute_max": 300
    },
    "spacing_ladder_fibonacci": [2, 4, 6, 10, 14, 22, 36, 58]
  }
}
